--- a/dlls/imm32/imm.c
+++ b/dlls/imm32/imm.c
@@ -994,3 +994,17 @@ BOOL WINAPI ImmDestroyContext(HIMC hIMC)
+#define MSCLASSIC_DIAG_NOTIFY_CONTEXT_DETACHED 0x4d534300u
+#define MSCLASSIC_DIAG_NOTIFY_CONTEXT_ATTACHED 0x4d534301u
+
+static void msclassic_input_diag_notify_context( HWND hwnd )
+{
+    char enabled[2];
+    HIMC himc;
+
+    if (GetEnvironmentVariableA( "MSCLASSIC_INPUT_DIAGNOSTIC", enabled, ARRAY_SIZE(enabled) ) != 1 ||
+        enabled[0] != '1') return;
+    himc = NtUserGetWindowInputContext( hwnd );
+    NtUserNotifyIMEStatus( hwnd, himc ? MSCLASSIC_DIAG_NOTIFY_CONTEXT_ATTACHED :
+                                      MSCLASSIC_DIAG_NOTIFY_CONTEXT_DETACHED );
+}
 /***********************************************************************
  *      ImmAssociateContext (IMM32.@)
  */
@@ -1013,1 +1027,2 @@ HIMC WINAPI ImmAssociateContext( HWND hwnd, HIMC new_himc )
+    if (ret != AICR_FAILED) msclassic_input_diag_notify_context( hwnd );
     return ret == AICR_FAILED ? 0 : old_himc;
@@ -1050,1 +1065,2 @@ BOOL WINAPI ImmAssociateContextEx( HWND hwnd, HIMC new_himc, DWORD flags )
+    if (ret != AICR_FAILED) msclassic_input_diag_notify_context( hwnd );
     return ret != AICR_FAILED;
