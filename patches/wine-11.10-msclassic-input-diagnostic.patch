diff --git a/dlls/winex11.drv/input_diag.c b/dlls/winex11.drv/input_diag.c
new file mode 100644
index 0000000..4826bf4
--- /dev/null
+++ b/dlls/winex11.drv/input_diag.c
@@ -0,0 +1,63 @@
+/* Privacy-bounded MapleStory input diagnostics. */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h>
+#include <unistd.h>
+
+#include "x11drv.h"
+
+struct msclassic_input_diag_record
+{
+    uint64_t monotonic_ns;
+    uint32_t sequence;
+    uint16_t category;
+    uint16_t schema;
+};
+
+static pthread_once_t diagnostic_once = PTHREAD_ONCE_INIT;
+static unsigned int diagnostic_sequence;
+static int diagnostic_fd = -1;
+
+static void init_diagnostic(void)
+{
+    const char *enabled = getenv( "MSCLASSIC_INPUT_DIAGNOSTIC" );
+    const char *value = getenv( "MSCLASSIC_INPUT_DIAGNOSTIC_FD" );
+    char *end;
+    long fd;
+
+    if (!enabled || strcmp( enabled, "1" ) || !value || !*value) return;
+    errno = 0;
+    fd = strtol( value, &end, 10 );
+    if (errno || *end || fd < 3 || fd > 0x7fffffff || fcntl( fd, F_GETFD ) == -1) return;
+    diagnostic_fd = fd;
+}
+
+void msclassic_input_diag_record( enum msclassic_input_diag_category category )
+{
+    struct msclassic_input_diag_record record;
+    struct timespec now;
+    ssize_t result;
+
+    pthread_once( &diagnostic_once, init_diagnostic );
+    if (diagnostic_fd < 0 || category < MSCLASSIC_DIAG_XIM_FILTERED_KEYBOARD ||
+        category > MSCLASSIC_DIAG_CONTEXT_DETACHED) return;
+    if (clock_gettime( CLOCK_MONOTONIC, &now ) == -1) return;
+
+    record.monotonic_ns = (uint64_t)now.tv_sec * 1000000000u + now.tv_nsec;
+    record.sequence = __atomic_add_fetch( &diagnostic_sequence, 1, __ATOMIC_RELAXED );
+    record.category = category;
+    record.schema = 1;
+    do result = write( diagnostic_fd, &record, sizeof(record) );
+    while (result == -1 && errno == EINTR);
+}
